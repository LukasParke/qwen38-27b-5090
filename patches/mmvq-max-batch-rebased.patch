+// Runtime override of the max batch size dispatched to the per-token MMVQ kernels.
+// Speculative-decoding verify batches (n_draft+1 tokens) re-read the full weight
+// matrix once per token under MMVQ; GEMM (MMQ) reads it once per step regardless
+// of token count, which is dramatically faster for batches >= 2 on Blackwell.
+// GGML_CUDA_MMVQ_MAX_BATCH=1 sends all multi-token batches to MMQ.
+static int mmvq_max_batch_env() {
+    static const int v = [] {
+        const char * s = getenv("GGML_CUDA_MMVQ_MAX_BATCH");
+        if (!s) {
+            return (int) MMVQ_MAX_BATCH_SIZE;
+        }
+        const int n = atoi(s);
+        return n < 1 ? 1 : n;
+    }();
+    return v;
+}
 
 typedef float (*vec_dot_q_cuda_t)(const void * __restrict__ vbq, const block_q8_1 * __restrict__ bq8_1, const int & kbx, const int & iqs);
 
